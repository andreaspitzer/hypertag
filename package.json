{
  "name": "hypertag",
  "version": "0.1.0",
  "description": "The fastest, edge-ready way to pull link preview tags from HTML into one card: Open Graph, Twitter cards, JSON-LD, meta tags and favicon – ~5 kB, no DOM, zero dependencies, lowest-memory. Runs on Node, Deno, Bun and Cloudflare Workers.",
  "keywords": [
    "opengraph",
    "open-graph",
    "link-preview",
    "unfurl",
    "og-tags",
    "meta-tags",
    "html-metadata",
    "html-parser",
    "cloudflare-workers",
    "edge",
    "favicon"
  ],
  "author": "Andreas Pitzer <hopster@gmail.com> (https://github.com/andreaspitzer)",
  "repository": "andreaspitzer/hypertag",
  "license": "MIT",
  "type": "module",
  "types": "./index.d.ts",
  "main": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./parse": {
      "types": "./parse.d.ts",
      "default": "./parse.js"
    },
    "./select": {
      "types": "./select.d.ts",
      "default": "./select.js"
    },
    "./sanitize": {
      "types": "./sanitize.d.ts",
      "default": "./sanitize.js"
    },
    "./ld": {
      "types": "./ld.d.ts",
      "default": "./ld.js"
    },
    "./meta": {
      "types": "./meta.d.ts",
      "default": "./meta.js"
    },
    "./fetch": {
      "types": "./fetch.d.ts",
      "default": "./fetch.js"
    },
    "./oembed": {
      "types": "./oembed.d.ts",
      "default": "./oembed.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "index.js",
    "index.d.ts",
    "parse.js",
    "parse.d.ts",
    "select.js",
    "select.d.ts",
    "sanitize.js",
    "sanitize.d.ts",
    "ld.js",
    "ld.d.ts",
    "meta.js",
    "meta.d.ts",
    "fetch.js",
    "fetch.d.ts",
    "oembed.js",
    "oembed.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "c8 ava",
    "pretest": "npm run lint",
    "lint": "biome lint",
    "format": "biome format --write",
    "smoke": "node scripts/smoke.js",
    "smoke:edge:tier1": "node test/edge/run-tier1.mjs node",
    "smoke:edge:tier1:node": "node test/edge/run-tier1.mjs node",
    "smoke:edge:tier1:bun": "node test/edge/run-tier1.mjs bun",
    "smoke:edge:tier1:deno": "node test/edge/run-tier1.mjs deno",
    "smoke:edge:tier2": "node test/edge/run-tier2.mjs node",
    "smoke:edge:tier2:node": "node test/edge/run-tier2.mjs node",
    "smoke:edge:tier2:bun": "node test/edge/run-tier2.mjs bun",
    "smoke:edge:tier2:deno": "node test/edge/run-tier2.mjs deno",
    "smoke:edge:handler": "node test/edge/run-handler.mjs node",
    "smoke:edge:handler:node": "node test/edge/run-handler.mjs node",
    "smoke:edge:handler:bun": "node test/edge/run-handler.mjs bun",
    "smoke:edge:cf": "node test/edge/cloudflare/deploy-check.mjs",
    "smoke:edge:vercel:local": "node test/edge/vercel/run-vercel.mjs node",
    "smoke:edge:vercel:local:node": "node test/edge/vercel/run-vercel.mjs node",
    "smoke:edge:vercel:local:bun": "node test/edge/vercel/run-vercel.mjs bun",
    "smoke:edge:vercel": "node test/edge/vercel/deploy-check.mjs",
    "prepublishOnly": "npm test && npm run smoke",
    "release": "commit-and-tag-version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "ava": "^8.0.1",
    "c8": "^12.0.0",
    "commit-and-tag-version": "^13.1.2",
    "husky": "^9.1.7"
  },
  "ava": {
    "files": [
      "test/**/*",
      "!test/edge/**"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "commit-and-tag-version": {
    "scripts": {
      "prerelease": "npm test"
    }
  }
}
