{
  "name": "hypertag",
  "version": "0.1.0",
  "description": "Tiny zero-dependency HTML parser: read tag attributes from an HTML string with a getElementsByTagName that needs no DOM. Runs on Node, Deno, Bun and the edge.",
  "keywords": [
    "html-parser",
    "parse-html",
    "html",
    "parser",
    "meta-tags",
    "meta",
    "open-graph",
    "og",
    "opengraph",
    "scraper",
    "attributes",
    "favicon",
    "cloudflare-workers",
    "getElementsByTagName"
  ],
  "author": "Andreas Pitzer <hopster@gmail.com> (https://github.com/andreaspitzer)",
  "repository": "andreaspitzer/hypertag",
  "license": "MIT",
  "type": "commonjs",
  "types": "./index.d.ts",
  "main": "./hypertag.js",
  "module": "./hypertag.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./hypertag.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./hypertag.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "hypertag.js",
    "hypertag.mjs",
    "index.d.ts",
    "index.d.mts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "c8 ava",
    "pretest": "npm run lint",
    "lint": "biome lint",
    "format": "biome format --write",
    "smoke": "node scripts/smoke.cjs && node scripts/smoke.mjs",
    "prepublishOnly": "npm test && npm run smoke",
    "release": "commit-and-tag-version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "ava": "^8.0.1",
    "c8": "^12.0.0",
    "commit-and-tag-version": "^13.1.2",
    "husky": "^9.1.7"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "commit-and-tag-version": {
    "scripts": {
      "prerelease": "npm test"
    }
  }
}
