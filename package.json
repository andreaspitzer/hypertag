{
  "name": "hypertag",
  "version": "0.0.6",
  "description": "The fastest HTML tag and attributes parser — a superfast getElementsByTagName without the DOM.",
  "keywords": [
    "html",
    "parser",
    "tag",
    "tags",
    "attributes",
    "getElementsByTagName",
    "fast",
    "scraper",
    "meta",
    "opengraph",
    "favicon"
  ],
  "author": "Andreas Pitzer <hopster@gmail.com> (https://github.com/andreaspitzer)",
  "repository": "andreaspitzer/hypertag",
  "license": "MIT",
  "source": "hypertag.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "sideEffects": false,
  "files": [
    "dist",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rimraf dist && microbundle -f cjs",
    "test": "nyc ava",
    "pretest": "xo",
    "smoke": "node scripts/smoke.cjs",
    "prepublishOnly": "npm test && npm run build && npm run smoke",
    "release": "standard-version"
  },
  "devDependencies": {
    "@andreaspizsa/eslint-config-xo": "^0.2.0",
    "@commitlint/cli": "^9.1.2",
    "@commitlint/config-conventional": "^7.1.2",
    "ava": "^4.0.1",
    "benchmark": "^2.1.4",
    "cheerio": "^1.0.0-rc.2",
    "coveralls": "^3.0.2",
    "fast-html": "^0.1.2",
    "got": "^9.3.2",
    "html-parse-stringify2": "^2.0.1",
    "html-tag-parser": "^1.0.0",
    "htmlparser2": "^3.10.0",
    "husky": "^1.2.0",
    "microbundle": "^0.14.2",
    "microtime": "^3.0.0",
    "nyc": "^15.1.0",
    "parse5": "^5.1.0",
    "rimraf": "^2.6.2",
    "standard-version": "^9.3.2",
    "xo": "^0.47.0"
  },
  "xo": {
    "semicolon": false,
    "space": true,
    "ignores": [
      "dist",
      "*.d.ts"
    ],
    "rules": {
      "unicorn/prefer-module": 0,
      "padding-line-between-statements": 0,
      "comma-dangle": 0
    },
    "extends": [
      "@andreaspizsa/eslint-config-xo"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "standard-version": {
    "scripts": {
      "prerelease": "npm test && npm run build"
    }
  }
}
